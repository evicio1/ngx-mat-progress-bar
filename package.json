{
  "name": "ngx-mat-progress-bar",
  "version": "20.1.0",
  "description": "Angular Material progress bar library workspace with modern Angular standalone architecture",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build mat-progress-bar-library",
    "build:demo": "ng build demo",
    "build:all": "npm run build:lib && npm run build:demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:lib": "ng test mat-progress-bar-library",
    "serve:demo": "ng serve demo --open",
    "package": "npm run build:lib && cd dist/mat-progress-bar-library && npm pack",
    "publish:npm": "npm run build:lib && cd dist/mat-progress-bar-library && npm publish"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.25",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.7",
    "typescript": "~5.9.2"
  }
}
