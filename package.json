{
  "name": "ngx-mat-progress-bar",
  "version": "22.0.0",
  "description": "Angular Material progress bar library workspace with modern Angular standalone architecture",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build mat-progress-bar-library",
    "postbuild:lib": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync(f, 'dist/mat-progress-bar-library/' + f)\"",
    "build:demo": "ng build demo",
    "build:all": "npm run build:lib && npm run build:demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:lib": "ng test mat-progress-bar-library",
    "serve:demo": "ng serve demo --open",
    "package": "npm run build:lib && cd dist/mat-progress-bar-library && npm pack --pack-destination ..",
    "publish:npm": "npm run build:lib && cd dist/mat-progress-bar-library && npm publish"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3"
  }
}
